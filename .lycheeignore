# TODO: 404. GitHub raw needs /owner/repo/<ref>/<path>. This bare origin is an
# allowlist line in SUBSTACK.md and TWITTER.md, not a file.
^https://raw\.githubusercontent\.com/rmcnally11/onthiswater/?$

